        <mxCell id="R1" value="&lt;b&gt;R1  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;turn time unmeasured&lt;br&gt;task prompt&lt;br&gt;rationale + solution.py + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="930" y="180" width="220" height="65" as="geometry" />
