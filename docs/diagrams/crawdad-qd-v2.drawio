<mxfile host="drawio" version="32.4.1">
  <diagram id="crawdad-qd-v2" name="Qwen + DeepSeek on the debate tree v2">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Our Qwen + DeepSeek stack on the CRAwDAD tree, mapped one-to-one (v2, 2026-10-15)&lt;/b&gt;&lt;br&gt;Same shape as crawdad-v0: coin, 4 rounds max, leaves at R2 / R3 / R4, grade only at the leaf. Our models in the two seats, our grader as the answer key. Models updated 2026-10-15 to the paper&#39;s own pair (DeepSeek V4 Flash abandoned for this direction). Turn times for this pair are unmeasured. Under the one-model rule a swap sits on every edge between colours." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="45" as="geometry" />
        </mxCell>

        <!-- root -->
        <mxCell id="root" value="&lt;b&gt;Coding task&lt;/b&gt;&lt;br&gt;spec + visible tests&lt;br&gt;random first speaker (coin)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="65" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ===== left subtree: Qwen first ===== -->
        <mxCell id="L1" value="&lt;b&gt;R1  Qwen3-32B&lt;/b&gt;&lt;br&gt;turn time unmeasured&lt;br&gt;task prompt&lt;br&gt;rationale + solution.py + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;R2  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;turn time unmeasured&lt;br&gt;review the code; not forced to find a flaw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="LF2" value="&lt;b&gt;FINAL at R2&lt;/b&gt;&lt;br&gt;consensus, 2 rounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;R3  Qwen3-32B&lt;/b&gt;&lt;br&gt;defend or revise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="LF3" value="&lt;b&gt;FINAL at R3&lt;/b&gt;&lt;br&gt;Qwen revised to agree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="190" y="540" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;R4  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;last word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="LF4" value="&lt;b&gt;FINAL at R4&lt;/b&gt;&lt;br&gt;DeepSeek's code stands,&lt;br&gt;even if they still disagree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="650" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eRL" value="Qwen first" style="endArrow=classic;html=1;" edge="1" parent="1" source="root" target="L1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eL12" value="rationale + code + confidence&lt;br&gt;(reasoning trace withheld)" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="L1" target="L2">
          <mxGeometry relative="1" as="geometry" />
