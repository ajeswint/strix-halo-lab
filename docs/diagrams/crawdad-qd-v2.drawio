          <mxGeometry x="930" y="300" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="RF2" value="&lt;b&gt;FINAL at R2&lt;/b&gt;&lt;br&gt;consensus, 2 rounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="420" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;R3  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;defend or revise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1030" y="420" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RF3" value="&lt;b&gt;FINAL at R3&lt;/b&gt;&lt;br&gt;DeepSeek revised to agree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="890" y="540" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;R4  Qwen3-32B&lt;/b&gt;&lt;br&gt;last word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="540" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RF4" value="&lt;b&gt;FINAL at R4&lt;/b&gt;&lt;br&gt;Qwen's code stands,&lt;br&gt;even if they still disagree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1120" y="650" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eRR" value="DeepSeek first" style="endArrow=classic;html=1;" edge="1" parent="1" source="root" target="R1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR12" value="rationale + code + confidence&lt;br&gt;(reasoning trace withheld)" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="R1" target="R2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR2F" value="agree" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="R2" target="RF2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR23" value="disagree: critique" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="R2" target="R3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eR3F" value="revise" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="R3" target="RF3">
