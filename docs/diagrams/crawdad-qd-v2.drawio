        <!-- ===== side rails ===== -->
        <mxCell id="extract" value="&lt;b&gt;Extractor: agent.py code-block parser&lt;/b&gt; (no model)&lt;br&gt;pulls solution.py and the verdict line from every reply. Not a judge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="grade" value="&lt;b&gt;Grade: hidden unit tests, fresh seed 104729&lt;/b&gt; (bwrap grader) on the leaf's code. No judge model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="750" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stats" value="&lt;b&gt;Walk cost (UNMEASURED, estimate):&lt;/b&gt; both models are dense 32B Q4_K_M (18.4 / 18.5 GiB). Generation is bandwidth bound: first-load smoke tg 11.1 / 11.2 t/s (one cold request at ~1.1k prompt; the ~6 t/s estimate was low), so a 4,000-token reply is ~6 min if that one-request rate holds; slower at depth. A leaf at R2 / R3 / R4 costs 2 / 3 / 4 replies. Memory: the pair plus both RAGs fits on paper (first-load deltas add to ~72 GiB: 32B pair at ctx 32k, both embedders and the shared reranker (+7.3) at ctx 8192, incl. 7.3 baseline, of 108; 64.9 without the reranker; not measured co-resident), but gpu-guard (16 GiB cutoff) and llmctl (one session) keep one model resident, so each colour change is a swap. GTT deltas measured at first load 2026-10-15; turn times still unmeasured." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="740" width="440" height="175" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="blue = Qwen3-32B Q4_K_M (RAG 1 Qwen3-Embedding-0.6B, slots 1 solver / 2 critic) &amp;nbsp; orange = DeepSeek-R1-Distill-Qwen-32B Q4_K_M (RAG 2 EmbeddingGemma 2, slots 3 solver / 4 critic) &amp;nbsp; shared reranker Qwen3-Reranker-4B &amp;nbsp; green = leaf (debate ends) &amp;nbsp; depth cap = 4 rounds" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="850" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
