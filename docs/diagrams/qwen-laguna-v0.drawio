        <mxCell id="ragB" value="&lt;b&gt;RAG-B&lt;/b&gt; (adversary side)&lt;br&gt;corpus: attacks that broke code&lt;br&gt;embedder/reranker TBD&lt;br&gt;sqlite-vec, 2-6 GiB est." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3399ff;" vertex="1" parent="1">
          <mxGeometry x="1010" y="185" width="200" height="80" as="geometry" />
