        <mxCell id="e5" value="attack: counter-cases, critique" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.75;entryX=1;entryY=0.25;dashed=1;" edge="1" parent="1" source="s2" target="grader">
