          <mxGeometry x="40" y="690" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ds" value="&lt;b&gt;DeepSeek V4 Flash&lt;/b&gt; :8080&lt;br&gt;+85.5 GiB: does not fit beside 2 slots&lt;br&gt;fixer, solo runs only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="560" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="&lt;b&gt;GTT budget (estimate, additive, unmeasured co-resident)&lt;/b&gt;&lt;br&gt;baseline ~6.5&lt;br&gt;+ Qwen 22.4 + Laguna 20.7&lt;br&gt;+ RAGs 2-6 + DBs &amp;lt;1 + client &amp;lt;=8&lt;br&gt;= ~50 core, ~65 worst / 108 GiB&lt;br&gt;slots 3+4: ~40 GiB left for both&lt;br&gt;bandwidth ~117 GB/s shared by all generators" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="840" y="560" width="370" height="130" as="geometry" />
        </mxCell>

        <!-- edges: loop -->
        <mxCell id="e1" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="tasks" target="agent">
