        <mxCell id="llmctl" value="&lt;b&gt;scripts/llmctl.py&lt;/b&gt; (control plane)&lt;br&gt;up to 4 live sessions, one per slot/port 8081-8084&lt;br&gt;sessions table in /data/orch/orch.db&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;one-session rule: REMOVED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
