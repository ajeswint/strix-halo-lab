          <mxGeometry x="840" y="310" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db4" value="slot4.db&lt;br&gt;SQLite WAL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="410" width="110" height="60" as="geometry" />
