        <!-- DBs 1:1 with slots -->
        <mxCell id="db1" value="slot1.db&lt;br&gt;SQLite WAL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="840" y="75" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db2" value="slot2.db&lt;br&gt;SQLite WAL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="840" y="195" width="110" height="60" as="geometry" />
