        <!-- RAGs -->
        <mxCell id="ragA" value="&lt;b&gt;RAG-A&lt;/b&gt; (solver side)&lt;br&gt;corpus: past passes + failures&lt;br&gt;embedder/reranker TBD&lt;br&gt;sqlite-vec, 2-6 GiB est." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3399ff;" vertex="1" parent="1">
