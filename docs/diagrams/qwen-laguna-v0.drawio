<mxfile host="drawio" version="32.4.1">
  <diagram id="arch-v0" name="Qwen+Laguna v0">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Qwen + Laguna adversary stack, v0 (draft for your tweaks, 2026-10-12)&lt;/b&gt;&lt;br&gt;Host: Strix Halo, 128 GiB unified, GTT cap 108 GiB. Up to 4 LLMs resident. Memory guard removed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- loop -->
        <mxCell id="tasks" value="&lt;b&gt;Task sets&lt;/b&gt;&lt;br&gt;v0-v5 (design)&lt;br&gt;v6 sealed held-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;agent.py loop driver&lt;/b&gt;&lt;br&gt;K turns x E episodes&lt;br&gt;token budget per task&lt;br&gt;stop on repeat error / code hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="grader" value="&lt;b&gt;Grader (bwrap)&lt;/b&gt;&lt;br&gt;hidden tests + compiler&lt;br&gt;RLIMIT_AS 1 GiB&lt;br&gt;models cannot write to it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="oracle" value="&lt;b&gt;Final grade&lt;/b&gt;&lt;br&gt;fresh oracle seed&lt;br&gt;never shown to the loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="results" value="&lt;b&gt;Results&lt;/b&gt;&lt;br&gt;bench/loop/results/*.jsonl" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- LLM slots -->
        <mxCell id="s1" value="&lt;b&gt;Slot 1: Qwen3.6-35B-A3B&lt;/b&gt; :8081&lt;br&gt;role: solver (writes solution.py)&lt;br&gt;+22.4 GiB (ctx 65536, np 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Slot 2: Laguna XS 2.1&lt;/b&gt; :8082&lt;br&gt;role: adversary (attacks the solution)&lt;br&gt;+20.7 GiB (ctx 32768, np 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="540" y="190" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Slot 3: free&lt;/b&gt; :8083&lt;br&gt;role TBD, size unbudgeted" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1">
