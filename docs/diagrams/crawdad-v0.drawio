<mxfile host="drawio" version="32.4.1">
  <diagram id="crawdad-v0" name="CRAwDAD debate tree v0">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;CRAwDAD dual-agent debate as a decision tree (v0, 2026-10-15)&lt;/b&gt;&lt;br&gt;Vamosi &amp;amp; Forkert, arXiv 2511.22854 (AAMAS 2026). Drawn by Claude from the paper's text; the paper has no architecture figure (its Fig. 1 is a worked example). One question = one walk from root to a leaf." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="45" as="geometry" />
        </mxCell>

        <!-- root -->
        <mxCell id="root" value="&lt;b&gt;CLadder question&lt;/b&gt;&lt;br&gt;random first speaker (coin)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="65" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ===== left subtree: Qwen3 first ===== -->
        <mxCell id="L1" value="&lt;b&gt;R1  Qwen3-32B&lt;/b&gt;&lt;br&gt;full CausalCoT prompt, &quot;be confident&quot;&lt;br&gt;rationale + yes/no + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;R2  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;scrutinise; not forced to find a flaw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="230" y="300" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="LF2" value="&lt;b&gt;FINAL at R2&lt;/b&gt;&lt;br&gt;consensus, 2 rounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;R3  Qwen3-32B&lt;/b&gt;&lt;br&gt;defend or revise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="LF3" value="&lt;b&gt;FINAL at R3&lt;/b&gt;&lt;br&gt;Qwen3 revised to agree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="190" y="540" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;R4  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;last word" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
