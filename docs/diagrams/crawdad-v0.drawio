        <mxCell id="R1" value="&lt;b&gt;R1  R1-Distill-Qwen-32B&lt;/b&gt;&lt;br&gt;full CausalCoT prompt, &quot;be confident&quot;&lt;br&gt;rationale + yes/no + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
