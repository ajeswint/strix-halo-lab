        </mxCell>
        <mxCell id="eL12" value="rationale + answer + confidence&lt;br&gt;(reasoning trace withheld)" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="L1" target="L2">
          <mxGeometry relative="1" as="geometry" />
