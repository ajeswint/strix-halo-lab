        <!-- ===== side rails ===== -->
        <mxCell id="extract" value="&lt;b&gt;Extractor: Granite 3.3 2B&lt;/b&gt;&lt;br&gt;reads every reply (blue and orange nodes), returns yes/no + confidence. Not a judge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="grade" value="&lt;b&gt;Grade: CLadder answer key&lt;/b&gt; on the leaf's answer. No judge model. Ours would be the unit tests on a fresh seed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="750" width="400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="stats" value="&lt;b&gt;Leaf shares (paper Fig. 6, pooled over first speaker):&lt;/b&gt; FINAL at R2 ~93% / 82% / 75% for Rung 1 / 2 / 3. Harder questions go deeper. Persuasion follows opponent confidence (Fig. 4); defenders do not lower confidence (Fig. 5). Overall: Qwen3 84.16 -&amp;gt; 89.41%, R1-Distill 78.03 -&amp;gt; 87.45%. 380 h for 10,112 questions on Ollama." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="740" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="blue = Qwen3-32B &amp;nbsp; orange = DeepSeek-R1-Distill-Qwen-32B &amp;nbsp; green = leaf (debate ends) &amp;nbsp; depth cap = 4 rounds" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="900" height="25" as="geometry" />
        </mxCell>
      </root>
