        <mxCell id="prune" value="&lt;b&gt;Delete by history&lt;/b&gt;&lt;br&gt;drop rows whose retrievals did not help (all 4 DBs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="1020" width="250" height="60" as="geometry" />
