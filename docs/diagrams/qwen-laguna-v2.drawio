        <mxCell id="gate" value="&lt;b&gt;WRITE GATE&lt;/b&gt;: only grader-verified rows (pass on hidden tests, or attack valid vs reference) | family tag on every row | append-only, no model rewrites" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="230" y="670" width="840" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="verdicts" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;exitX=0.75;exitY=1;entryX=0.9;entryY=0;" edge="1" parent="1" source="grader" target="gate">
          <mxGeometry relative="1" as="geometry" />
