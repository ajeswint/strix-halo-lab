        <mxCell id="ds" value="&lt;b&gt;DeepSeek V4 Flash&lt;/b&gt; :8080, +85.5 GiB&lt;br&gt;fixer, solo only: does not fit beside the ring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1110" y="760" width="330" height="60" as="geometry" />
        </mxCell>
        <!-- buffer layer -->
