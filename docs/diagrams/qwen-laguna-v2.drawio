<mxfile host="drawio" version="32.4.1">
  <diagram id="arch-v2" name="Qwen+Laguna v2 buffer">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Qwen + Laguna stack, v2: ring + buffer with guardian and guardian adversary (2026-10-12)&lt;/b&gt;&lt;br&gt;Ring = the fight. Gate -&gt; buffer -&gt; guardian -&gt; DBs. Code: bench/loop/memring.py. Up to 4 LLMs resident; memory guard removed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="40" as="geometry" />
        </mxCell>

        <!-- ring -->
        <mxCell id="ringbg" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="640" height="460" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="&lt;b&gt;agent.py drives the ring&lt;/b&gt;&lt;br&gt;K turns x E episodes&lt;br&gt;token budget per task&lt;br&gt;stop on repeat error / code hash" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="305" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="qwen" value="&lt;b&gt;Slot 1: Qwen3.6-35B-A3B&lt;/b&gt; :8081&lt;br&gt;solver: writes solution.py&lt;br&gt;+22.4 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="550" y="85" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="grader" value="&lt;b&gt;Grader (bwrap)&lt;/b&gt;&lt;br&gt;hidden tests + compiler&lt;br&gt;RLIMIT_AS 1 GiB, read-only to models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="870" y="315" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="laguna" value="&lt;b&gt;Slot 2: Laguna XS 2.1&lt;/b&gt; :8082&lt;br&gt;adversary: writes counter-cases&lt;br&gt;+20.7 GiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="550" y="545" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;Attack check (bwrap)&lt;/b&gt;&lt;br&gt;case must pass the reference,&lt;br&gt;then must break the solution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="230" y="315" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- open ports -->
        <mxCell id="p3" value="&lt;b&gt;slot 3&lt;/b&gt; :8083&lt;br&gt;guardian LLM, model TBD" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="830" y="150" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;slot 4&lt;/b&gt; :8084&lt;br&gt;adversary LLM, model TBD" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- ring edges -->
        <mxCell id="e1" value="solution.py" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="1" source="qwen" target="grader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="passed: attack it" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="grader" target="laguna">
