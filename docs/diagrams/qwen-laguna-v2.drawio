        <mxCell id="pr1" style="html=1;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="prune" target="db4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- control plane, right column -->
        <mxCell id="budget" value="&lt;b&gt;GTT budget (estimate)&lt;/b&gt;&lt;br&gt;baseline ~6.5 + Qwen 22.4 + Laguna 20.7&lt;br&gt;+ RAGs 2-6 + DBs &amp;lt;1 + client &amp;lt;=8&lt;br&gt;= ~50 core, ~65 worst / 108 GiB&lt;br&gt;ports 3+4: ~40 GiB left for both" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
