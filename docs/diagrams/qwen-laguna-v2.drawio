          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gadv" value="&lt;b&gt;Guardian adversary&lt;/b&gt;&lt;br&gt;canaries from real rows each flush&lt;br&gt;inside (re-sealed): rename, reformat, deadcode, inject, oversize&lt;br&gt;outside (forged): relabel, flip kind, replay seal, stale grader&lt;br&gt;+ slot 4 LLM mutations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
