        <mxCell id="rA2" value="retrieve, same family only" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3399ff;exitX=0.5;exitY=0;entryX=0;entryY=0.25;" edge="1" parent="1" source="ragA" target="qwen">
          <mxGeometry relative="1" as="geometry">
