        <mxCell id="g2" value="valid attacks" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;exitX=0.25;exitY=1;entryX=0.05;entryY=0;" edge="1" parent="1" source="check" target="gate">
          <mxGeometry relative="1" as="geometry" />
