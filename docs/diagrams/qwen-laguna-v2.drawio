        <mxCell id="e4" value="valid break: fed back" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="check" target="qwen">
          <mxGeometry relative="1" as="geometry" />
