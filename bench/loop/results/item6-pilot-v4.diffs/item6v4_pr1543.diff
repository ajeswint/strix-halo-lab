@@ -444,9 +446,22 @@ class Interpreter(_Decoratable, ABC, Generic[_Leaf_T, _Return_T]):
 _InterMethod = Callable[[Type[Interpreter], _Return_T], _R]
 
 def visit_children_decor(func: _InterMethod) -> _InterMethod:
-    "See Interpreter"
+    """Decorator for Interpreter methods that automatically visits children.
+    
+    When applied to a method of an ``Interpreter`` subclass, it replaces the
+    ``tree.children`` argument with the results of visiting each child tree.
+    
+    This is equivalent to calling ``self.visit_children(tree)`` and passing
+    the result to the decorated function.
+    
+    Note:
+        This decorator can only be used with methods of ``Interpreter`` subclasses.
+        Using it on methods of other classes will raise a ``TypeError``.
+    """
     @wraps(func)
     def inner(cls, tree):
+        if not isinstance(cls, Interpreter):
+            raise TypeError("@visit_children_decor can only be used on methods of Interpreter subclasses")
         values = cls.visit_children(tree)
         return func(cls, values)
     return inner
