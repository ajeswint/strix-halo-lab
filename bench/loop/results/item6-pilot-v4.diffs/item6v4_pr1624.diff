+    def test_transformer_variants_discard_with_preceding_sibling(self):
+        """Discard on a non-last child must not corrupt the tree for any transformer variant."""
+        tree = Tree('start', [
+            Tree('keep', ['a']),
+            Tree('discard', ['b']),
+            Tree('keep', ['c']),
+        ])
+        for base in (Transformer, Transformer_InPlace, Transformer_NonRecursive, Transformer_InPlaceRecursive):
+            class T(base):
+                def start(self, children):
+                    return children
+
+                def keep(self, children):
+                    return children[0]
+
+                def discard(self, children):
+                    return Discard
+
+            copied = copy.deepcopy(tree)
+            result = T().transform(copied)
+            self.assertEqual(result, Tree('start', ['a', 'c']))
+
